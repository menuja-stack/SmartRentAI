# ============================================================
# SmartRentAI Backend Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to Git.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# Database (XAMPP MySQL - default settings)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartrentai

# JWT — generate your own random secret, do not reuse this example
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# AI Microservices
AI_RECOMMENDATION_URL=http://localhost:8001
AI_PRICE_URL=http://localhost:8002
AI_CHATBOT_URL=http://localhost:8003
AI_LOCATION_URL=http://localhost:8004

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Email (optional - for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@smartrentai.lk

# Google Maps (optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Optional — only if `python` is not on the server's PATH (for POST /api/scraper/run)
# PYTHON_BIN=C:\path\to\python.exe
